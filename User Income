        "\n",
        "%%writefile /content/app.py\n",
        "\n",
        "import os\n",
        "import joblib\n",
        "import pandas as pd\n",
        "\n",
        "from fastapi import FastAPI, HTTPException\n",
        "from fastapi.responses import FileResponse\n",
        "from fastapi.staticfiles import StaticFiles\n",
        "from pydantic import BaseModel, Field\n",
        "\n",
        "BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n",
        "\n",
        "model = joblib.load(os.path.join(BASE_DIR, \"model.pkl\"))\n",
        "\n",
        "app = FastAPI(\n",
        "    title=\"Loan Eligibility AI\",\n",
        "    description=\"Demonstration ML application using FastAPI\",\n",
        "    version=\"1.0\"\n",
        ")\n",
        "\n",
        "app.mount(\n",
        "    \"/static\",\n",
        "    StaticFiles(directory=BASE_DIR),\n",
        "    name=\"static\"\n",
        ")\n",
        "\n",
        "\n",
        "class Applicant(BaseModel):\n",
        "    age: int = Field(..., ge=18, le=100)\n",
        "    income: float = Field(..., gt=0, le=1_000_000_000)\n",
        "\n",
        "\n",
        "@app.get(\"/\")\n",
        "def home():\n",
        "    return FileResponse(\n",
        "        os.path.join(BASE_DIR, \"index.html\")\n",
        "    )\n",
        "\n",
        "\n",
        "@app.get(\"/health\")\n",
        "def health():\n",
        "    return {\"status\": \"running\", \"model_loaded\": True}\n",
        "\n",
        "\n",
        "@app.post(\"/predict\")\n",
        "def predict(applicant: Applicant):\n",
        "    try:\n",
        "        data = pd.DataFrame(\n",
        "            [[applicant.age, applicant.income]],\n",
        "            columns=[\"age\", \"income\"]\n",
        "        )\n",
        "\n",
        "        prediction = int(model.predict(data)[0])\n",
        "\n",
        "        probabilities = model.predict_proba(data)[0]\n",
        "        confidence = float(max(probabilities) * 100)\n",
        "\n",
        "        result = \"YES\" if prediction == 1 else \"NO\"\n",
        "\n",
        "        return {\n",
        "            \"prediction\": result,\n",
        "            \"confidence\": round(confidence, 2),\n",
        "            \"message\": (\n",
        "                \"Eligible under the demonstration model\"\n",
        "                if prediction == 1\n",
        "                else \"Not eligible under the demonstration model\"\n",
        "            ),\n",
        "            \"disclaimer\": (\n",
        "                \"Demo prediction only; not a real lending decision.\"\n",
        "            )\n",
        "        }\n",
        "\n",
        "    except Exception as exc:\n",
        "        raise HTTPException(\n",
        "            status_code=500,\n",
        "            detail=f\"Prediction failed: {str(exc)}\"\n",
        "        )"
      ],
