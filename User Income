        "    server_process.wait()\n",
        "\n",
        "server_process = subprocess.Popen(\n",
        "    [\n",
        "        \"python\", \"-m\", \"uvicorn\",\n",
        "        \"app:app\",\n",
        "        \"--app-dir\", \"/content\",\n",
        "        \"--host\", \"0.0.0.0\",\n",
        "        \"--port\", \"8000\"\n",
        "    ],\n",
        "    cwd=\"/content\",\n",
        "    stdout=open(\"/content/uvicorn.log\", \"w\"),\n",
        "    stderr=subprocess.STDOUT\n",
        ")\n",
        "\n",
        "for attempt in range(20):\n",
        "    try:\n",
        "        response = requests.get(\n",
        "            \"http://127.0.0.1:8000/health\",\n",
